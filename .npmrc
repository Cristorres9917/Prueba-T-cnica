# ==============================================================================
# SEGURIDAD Y GESTIÓN DE DEPENDENCIAS - DIRECTIVAS ESTRICTAS
# ==============================================================================
# Bloqueo de paquetes publicados hace menos de 48 horas (48 * 60 = 2880 minutos)
# Protección contra supply-chain attacks y releases no verificados
minimum-release-age=2880

# Forzar versiones estrictas de engines y paquetes
engine-strict=true
save-exact=true
prefer-frozen-lockfile=true

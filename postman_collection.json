  "item": [
    {
      "name": "🌐 1. Placetopay WebCheckout (Sandbox Directo)",
      "description": "Consumo directo contra los endpoints oficiales de Placetopay Sandbox (https://checkout-test.placetopay.com/). Los Pre-request Scripts generan automáticamente el bloque criptográfico 'auth'.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generación dinámica del objeto de autenticación canónico Placetopay",
              "const seed = new Date().toISOString();",
              "const rawNonce = CryptoJS.lib.WordArray.random(16);",
              "const nonce = CryptoJS.enc.Base64.stringify(rawNonce);",
              "const secretKey = pm.collectionVariables.get('secretKey') || '3YC5brb5eAR4xBGQ';",
              "",
              "// tranKey = Base64(SHA256(rawNonce + seed + secretKey))",
              "const combined = rawNonce.clone().concat(CryptoJS.enc.Utf8.parse(seed + secretKey));",
              "const tranKey = CryptoJS.enc.Base64.stringify(CryptoJS.SHA256(combined));",
              "",
              "pm.collectionVariables.set('seed', seed);",
              "pm.collectionVariables.set('nonce', nonce);",
              "pm.collectionVariables.set('tranKey', tranKey);",
              "pm.collectionVariables.set('dynamicRef', 'P2P-WEB-' + Date.now());"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "1.1 Crear Sesión WebCheckout (POST /api/session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Sesión creada exitosamente (status OK)', function () {",
                  "    pm.expect(res.status.status).to.eql('OK');",
                  "    pm.expect(res.requestId).to.be.a('number');",
                  "    pm.expect(res.processUrl).to.be.a('string');",
                  "});",
                  "if (res.requestId) {",
                  "    pm.collectionVariables.set('requestId', res.requestId.toString());",
                  "    pm.collectionVariables.set('processUrl', res.processUrl);",
                  "    console.log('✅ RequestId guardado para siguientes llamadas:', res.requestId);",
                  "    console.log('🔗 URL para pagar en el navegador:', res.processUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auth\": {\n    \"login\": \"{{login}}\",\n    \"tranKey\": \"{{tranKey}}\",\n    \"nonce\": \"{{nonce}}\",\n    \"seed\": \"{{seed}}\"\n  },\n  \"buyer\": {\n    \"name\": \"Carlos\",\n    \"surname\": \"Gómez\",\n    \"email\": \"carlos.gomez@evertecinc.com\",\n    \"document\": \"1020304050\",\n    \"documentType\": \"CC\",\n    \"mobile\": \"3001234567\",\n    \"address\": {\n      \"street\": \"Carrera 7 # 72-01\",\n      \"city\": \"Bogotá\"\n    }\n  },\n  \"payment\": {\n    \"reference\": \"{{dynamicRef}}\",\n    \"description\": \"Compra de Smartphone Apple iPhone 16 Pro Max\",\n    \"amount\": {\n      \"currency\": \"COP\",\n      \"total\": 6499000\n    },\n    \"allowPartial\": false,\n    \"subscribe\": false\n  },\n  \"expiration\": \"2026-10-03T12:00:00-05:00\",\n  \"returnUrl\": \"{{localApiUrl}}/?status=return&reference={{dynamicRef}}\",\n  \"ipAddress\": \"127.0.0.1\",\n  \"userAgent\": \"Postman-Evertec-Tester/1.0\"\n}"
            },
            "url": {
              "raw": "{{checkoutUrl}}/api/session",
              "host": ["{{checkoutUrl}}"],
              "path": ["api", "session"]
            }
          }
        },
        {
          "name": "1.2 Consultar Estado de Sesión (POST /api/session/{{requestId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna objeto status de la sesión', function () {",
                  "    pm.expect(res.status).to.be.an('object');",
                  "    console.log('Estado actual de la sesión:', res.status.status, '-', res.status.message);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auth\": {\n    \"login\": \"{{login}}\",\n    \"tranKey\": \"{{tranKey}}\",\n    \"nonce\": \"{{nonce}}\",\n    \"seed\": \"{{seed}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{checkoutUrl}}/api/session/{{requestId}}",
              "host": ["{{checkoutUrl}}"],
              "path": ["api", "session", "{{requestId}}"]
            }
          }
        }
      ]
